# Neural Nexus customer portal server — environment variables (no values here).
# Copy to .env (Stripe test mode) and .env.live (Stripe live mode); switch with
#   docker compose --env-file .env.live up

# Which env file docker compose feeds the portal-server container. Leave empty
# (defaults to .env) in .env; set to .env.live inside .env.live so
# `docker compose --env-file .env.live up` picks the live file for the container.
COMPOSE_ENV_FILE=

# "test" or "live" — shown as a banner in the client.
PORTAL_ENV=
# "TRUE" logs one-time passcodes instead of emailing and pins the anonymous
# client ip to the f-metering development value (172.18.0.1).
DEV=
PORT=
# Comma-separated list of allowed browser origins (the Vercel client URL and
# http://localhost:5173 for local development).
CLIENT_ORIGIN=

# Session signing / one-time passcodes
SESSION_SIGNING_SECRET=
SESSION_TTL_HOURS=
ONE_TIME_PASSCODE_TTL_SECONDS=
ONE_TIME_PASSCODE_MAX_ATTEMPTS=

# Stripe (test keys in .env, live keys in .env.live)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional: the JSON blob printed by the f-metering provision_stripe_billing.py
# script. When empty, the portal discovers the catalog from product metadata.
STRIPE_BILLING_CONFIG_JSON=

# Auth0 Management API (machine-to-machine application) — required to toggle
# app_metadata.pay_per_use_enabled, which the Neural Nexus API gates on.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Neural Nexus API base URL (anonymous-user signup link).
NN_API_BASE_URL=

# One-time passcode email delivery (unused when DEV=TRUE).
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Cloudflare Tunnel token for the cloudflared docker-compose service.
CLOUDFLARE_TUNNEL_TOKEN=
