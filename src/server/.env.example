# Neural Nexus customer portal server — environment variables (no values here).
# Copy to .env (Stripe test mode) and .env.live (Stripe live mode); switch with
#   docker compose --env-file .env.live up

# Which env file docker compose feeds the portal-server container. Leave empty
# (defaults to .env) in .env; set to .env.live inside .env.live so
# `docker compose --env-file .env.live up` picks the live file for the container.
COMPOSE_ENV_FILE=

# "test" or "live" — shown as a banner in the client.
PORTAL_ENV=
# "TRUE" pins the anonymous client ip to the f-metering development value
# (172.18.0.1) so a local portal resolves the same anonymous customer.
DEV=
PORT=
# Comma-separated list of allowed browser origins (CORS). In production this is
# the client's public origin(s), e.g.
#   https://checkout.neuralnexus.site,https://anubis-customer-portal.vercel.app
# plus a localhost dev origin (http://localhost:5171).
CLIENT_ORIGIN=

# Session signing
SESSION_SIGNING_SECRET=
SESSION_TTL_HOURS=

# Stripe (test keys in .env, live keys in .env.live)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional: the JSON blob printed by the f-metering provision_stripe_billing.py
# script. When empty, the portal discovers the catalog from product metadata.
STRIPE_BILLING_CONFIG_JSON=

# Auth0 Management API (machine-to-machine application) — required to toggle
# app_metadata.pay_per_use_enabled, which the Neural Nexus API gates on.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Neural Nexus API base URL — email + password auth (login / logout / signup).
NN_API_BASE_URL=

# Must match the Neural Nexus API's USAGE_PERIOD_DAYS so the usage meters shown
# here cover the same window its allotment gating counts against. Empty or 0
# means calendar-month windows (the default on both sides).
USAGE_PERIOD_DAYS=

# Cloudflare Tunnel connector token for the cloudflared docker-compose service
# (read natively by cloudflared). Public hostname checkout-api.neuralnexus.site
# → http://portal-server:8080 is configured in the Cloudflare dashboard.
TUNNEL_TOKEN=
