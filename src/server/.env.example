# Neural Nexus customer portal server — environment variables (no values here).
#
# Two environments, one env file each, both gitignored:
#   .env      Stripe LIVE  — docker compose -f docker-compose.yml     up  (:8200)
#   .env.dev  Stripe test  — docker compose -f docker-compose.dev.yml up  (:8202)
#
# Each compose file names its env file literally, so there is no COMPOSE_ENV_FILE
# switch and no interpolation from a stray ./.env.

# "test" or "live" — "live" hides the client's TEST MODE banner.
PORTAL_ENV=
# "TRUE" pins the anonymous client ip to the Neural Nexus API development value
# (172.18.0.1) so a local portal resolves the same anonymous customer. Must be
# FALSE in the live environment.
DEV=
# Comma-separated list of allowed browser origins (CORS). Live is the client's
# public origins:
#   https://anubis-customer-portal.vercel.app,https://checkout.neuralnexus.site
# Test is the local dev origin (http://localhost:5171).
CLIENT_ORIGIN=

# Session signing. Use a different secret per environment so a session token
# minted by the test portal cannot validate against live.
SESSION_SIGNING_SECRET=
SESSION_TTL_HOURS=

# Stripe (live keys in .env, test keys in .env.dev)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional: the JSON blob printed by the Neural Nexus API repo's
# scripts/provision_stripe_billing.py, run against the matching key. When empty,
# the portal discovers the catalog from product metadata.
STRIPE_BILLING_CONFIG_JSON=

# Auth0 Management API (machine-to-machine application) — required to toggle
# app_metadata.pay_per_use_enabled, which the Neural Nexus API gates on.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Neural Nexus API base URL — email + password auth (login / logout / signup).
NN_API_BASE_URL=

# Must match the Neural Nexus API's USAGE_PERIOD_DAYS so the usage meters shown
# here cover the same window its allotment gating counts against. Empty or 0
# means calendar-month windows. Production runs 30; the development API runs 0.
USAGE_PERIOD_DAYS=

# Cloudflare Tunnel connector token, read natively by the OPTIONAL `cloudflared`
# compose service (profile `bundled-tunnel`), for hosts that do not already run
# a tunnel. Leave empty on a host whose cloudflared systemd service already
# routes checkout-api.neuralnexus.site to host port 8200.
TUNNEL_TOKEN=

# Shared secret authenticating POST /internal/usage-event, the push the Neural
# Nexus API sends after each metered turn so these meters move immediately
# instead of waiting for Stripe's aggregation. Must equal the API's
# PORTAL_USAGE_EVENT_SECRET exactly. Empty makes that endpoint refuse every
# request and usage falls back to the Stripe read alone.
USAGE_EVENT_SHARED_SECRET=
