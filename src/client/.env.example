# Base URL of the portal server. Vite inlines this at build time, so a rebuild
# is required after changing it. Two committed-by-convention files cover the two
# modes, and neither needs a Vercel dashboard variable:
#
#   .env.development  http://localhost:8202
#                     the TEST portal server (docker-compose.dev.yml). Loaded by
#                     `npm run dev` and by the client dev container. Never point
#                     local development at host port 8200 — that is the LIVE
#                     production stack and bills real customers.
#
#   .env.production   https://checkout-api.neuralnexus.site
#                     the Cloudflare tunnel hostname for the LIVE portal server.
#                     Loaded by `vite build`, which is what the Vercel git-push
#                     deploy runs. Committed on purpose (it is a public URL).
#
# A Vercel project environment variable named VITE_API_BASE_URL, if one is ever
# added, takes precedence over .env.production.
VITE_API_BASE_URL=
