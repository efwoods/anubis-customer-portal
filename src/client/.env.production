# Production build values. Vite loads this file for `vite build` (production
# mode), which is what the Vercel git-push deploy runs, so the production
# client is pointed at the Cloudflare Tunnel hostname without needing a
# Vercel dashboard environment variable.
#
# This file is deliberately committed (see the negation in .gitignore): the
# value is a public URL, not a secret. A Vercel project environment variable
# named VITE_API_BASE_URL, if one is ever added, takes precedence over this.
VITE_API_BASE_URL=https://checkout-api.neuralnexus.site

# The Neural Nexus application.
VITE_NEURAL_NEXUS_APP_ORIGINS=https://www.neuralnexus.site,https://neuralnexus.site
